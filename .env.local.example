# The base URL and the key are a pair: set both from the same account or the app refuses to start.
# Points at OpenAI today. Any OpenAI-compatible provider works, NEAR AI Cloud included.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.2
LLM_EMBED_MODEL=text-embedding-3-small

# Bright Data. No token belongs here: the field operators drive the `bdata` CLI, and the CLI keeps
# its own credentials. Run `bdata login` once instead.
# Both collector ids already default to ours in lib/operators/field/brightdata.ts. Set them only to
# point the field wing at different collectors.
BRIGHTDATA_PRIOR_ART_ID=
BRIGHTDATA_CORROBORATE_ID=

# The break-and-heal demo. All three are off by default and the app is complete without them.
# DOXA_DEMO_SHOP=1 puts the DEMO-SHOP operator in the planner's catalogue. Leave it unset for a
# normal run: it scrapes a supply catalogue that has nothing to do with most opinions.
# DOXA_DEMO_SHOP_BASE is the public base URL this app is reachable at, which is whatever tunnel is
# up. A quick tunnel takes a new hostname on every start, so there is no default:
#   cloudflared tunnel --url http://localhost:3000
DOXA_DEMO_SHOP=
DOXA_DEMO_SHOP_BASE=
BRIGHTDATA_DEMO_SHOP_ID=

# SigNoz Cloud. Tracing only: the app runs without these two.
SIGNOZ_ENDPOINT=https://ingest.us2.signoz.cloud
SIGNOZ_INGESTION_KEY=

# NEAR AI Cloud. These two are a pair: set both or the app refuses to start.
NEAR_AI_BASE_URL=
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_AI_EMBED_MODEL=

# Bright Data. The CLI stores its own credentials via `bdata login`.
# Collector ids are pinned in CLAUDE.md; these are for triggering them at run time.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_COLLECTOR_PRIOR_ART=
BRIGHTDATA_COLLECTOR_CORROBORATE=

# SigNoz Cloud
SIGNOZ_ENDPOINT=
SIGNOZ_INGESTION_KEY=
